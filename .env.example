# Copy to .env and fill in. .env is gitignored. On Modal these come from secrets instead.
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=site-safety-intelligence
LANGSMITH_TRACING=true
# Local Postgres for the app layer (decisions). On Modal: the Supabase pooler URL.
DATABASE_URL=postgresql://localhost:5432/ssi
# Where raw data and builds live (absolute path; shared across git worktrees)
SSI_DATA_DIR=/Users/peterhyland/Desktop/GitHub/site-safety-intelligence/data
SSI_MODEL=claude-sonnet-5-5
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
