# Copy to .env and fill in. .env is gitignored. On Modal these come from secrets instead.
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=site-safety-intelligence
LANGSMITH_TRACING=true
# Local Postgres for the app layer (decisions). On Modal: the Supabase pooler URL.
DATABASE_URL=postgresql://localhost:5432/ssi
# Where raw data and builds live (absolute path; shared across git worktrees)
SSI_DATA_DIR=/Users/peterhyland/Desktop/GitHub/site-safety-intelligence/data
SSI_MODEL=claude-sonnet-5-5
SSI_LLM_EFFORT=low
# Optional: OpenAI-compatible endpoints (e.g. models served on Modal) instead of Claude, one per role.
# A blank model uses whatever the endpoint serves. Modal proxy auth (key + secret) is shared.
SSI_LLM_PROVIDER=anthropic
SSI_LLM_FOREMAN_BASE_URL=
SSI_LLM_FOREMAN_MODEL=
SSI_LLM_ADJUDICATOR_BASE_URL=
SSI_LLM_ADJUDICATOR_MODEL=
# Reasoning effort per role (low/high/max), passed to the chat template. Blank: foreman low (GLM 5.3's default,
# max, costs seconds per answer), adjudicator whatever the server does.
SSI_LLM_FOREMAN_REASONING_EFFORT=
SSI_LLM_ADJUDICATOR_REASONING_EFFORT=
SSI_LLM_MODAL_KEY=
SSI_LLM_MODAL_SECRET=
# Optional: Jev (TypeSafe AI's decision model). With a key, Jev adjudicates uncertain matches without red flags
# and the adjudicator LLM the red-flagged ones (docs/adjudicator.md); SSI_ADJUDICATOR=llm sends all to the LLM.
# JEV_API_URL defaults to https://api.typesafe.ai (use TypeSafe's own API, not a reseller).
JEV_API_KEY=
JEV_API_URL=
SSI_ADJUDICATOR=
