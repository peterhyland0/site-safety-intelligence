# data and build outputs (never commit: ~10 GB)
data/
*.duckdb
*.duckdb.wal

# secrets
.env
.env.*
!.env.example

# eval: the rules' cases, rebuilt from the warehouse (the answer cache is kept)
eval/adjudication/.cases-*.json
eval/jev_search/.missed-*.json

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# web
web/node_modules/
web/dist/

# os
.DS_Store
.claude/*
!.claude/launch.json
# the web-check eval's raw Tavily responses (28 MB of page text): a local cache, so re-runs cost no searches
eval/web_check/searches.jsonl
